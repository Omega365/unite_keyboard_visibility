  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_runner_watch",
      "type": "shell",
      "command": "dart",
      "args": ["run", "build_runner", "watch", "--delete-conflicting-outputs"],
      "isBackground": true,
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "eye-watch"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "pigeon_gen",
      "detail": "Generate pigeon code",
      "type": "shell",
      "command": "dart",
      "args": ["run", "pigeon", "--input", "./pigeons/messages.dart"],
      "isBackground": false,
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "library"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ]
}
