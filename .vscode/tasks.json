{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_runner_watch",
      "type": "shell",
      "command": "dart",
      "args": ["run", "build_runner", "watch", "--delete-conflicting-outputs"],
      "isBackground": true,
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "eye-watch"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "base": "$dart-build_runner",
        "pattern": {
          "regexp": "^\\[(WARNING|SEVERE)\\] (.*)",
          "severity": 1,
          "message": 2,
          "file": 99 // A hack to ignore file match
        },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "^(\\[INFO\\] Starting Build|\\[INFO\\] Generating build|\\[INFO\\] Building)",
          "endsPattern": "^(\\[INFO\\] Succeeded|\\[SEVERE\\] Failed|\\[INFO\\] Builds finished)"
        }
      }
    },
    {
      "label": "pigeon_gen",
      "detail": "Generate pigeon code",
      "type": "shell",
      "command": "dart",
      "args": ["run", "pigeon", "--input", "./pigeons/messages.dart"],
      "isBackground": false,
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "library"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ]
}
